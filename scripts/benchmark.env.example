# Model Router Benchmark Config
# Copy this file to project root as .env and fill in your values.

BASE_URL=https://api.flyagent.work
API_KEY=your_api_key_here
MODEL=kimi-k2.6

# Optional
MAX_TOKENS=256
CONCURRENCY=5
REQUESTS=20
WARMUP=2
TIMEOUT_MS=30000
# PROMPT=用一句话总结 model-router 的设计目标，并列出它的三个核心特性。
