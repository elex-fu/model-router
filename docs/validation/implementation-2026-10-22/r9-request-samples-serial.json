  "measurementSemantics": {
    "quantile": "sorted[min(n-1, floor(n*p))], zero-based; stable numeric sort; at n=100 p99 selects index 99 and equals max",
    "rounding": "Existing report rounds percentile values to two decimal places; selected metricMs retains the original duration",
    "comparisonSets": "Direct and gateway samples are independent sets, not paired requests; overhead is gateway p99 minus independent direct p99",
    "latency": "Original performance.now start before fetch to response headers; existing body text drain then HTTP-200 inclusion rule is preserved",
    "ttfb": "Original performance.now start before request to first body reader.read completion; metric ends before await reader.cancel; original nonempty-chunk/success inclusion follows cancellation",
    "observation": "Client sample/header collection occurs after existing body drain or stream cancellation; no warmup or smoke samples are copied",
    "wallClockNotes": "startedAt is client wall clock before original metric start; recordedAt is after drain/cancel and is not a wire-completion timestamp",
