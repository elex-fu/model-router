  },
  "timestampSemantics": {
    "request_created_at": {
      "clock": "Application wall clock, JavaScript Date millisecond precision",
      "write": "admitPreparedRequest samples normalizeNow(this.now) before request INSERT; INSERT explicitly writes created_at and initial updated_at. Schema DEFAULT now() is not used on this path.",
      "source": [
        "src/saas/metering/service.ts:2024",
        "src/saas/metering/service.ts:1690",
        "src/saas/metering/service.ts:1637"
      ]
    },
    "attempt_created_at": {
      "clock": "Application wall clock, separately sampled JavaScript Date",
      "write": "insertAttempt samples after preceding request/binding/ordinal checks and explicitly writes created_at and initial updated_at; not the PG schema default.",
      "source": [
        "src/saas/metering/service.ts:1820",
        "src/saas/metering/service.ts:1843"
      ]
    },
    "evidence_created_at": {
      "clock": "PostgreSQL now(), equivalent to transaction_timestamp(), fixed at transaction start",
      "write": "Evidence INSERT omits created_at and uses DEFAULT now(). Admission and evidence registration share the caller-owned preparation transaction; this timestamp can precede request_created_at even though the evidence INSERT occurs later.",
      "source": [
        "src/saas/db/migrations/024_prepared_request_evidence.ts:111",
        "src/saas/gateway/prepared-request-evidence-service.ts:1021",
        "src/saas/gateway/prepared-request-evidence-service.ts:1836",
        "src/saas/gateway/request-preparation-service.ts:2530",
        "src/saas/gateway/request-preparation-service.ts:2629"
      ]
    },
    "evidence_claimed_at": {
      "clock": "PostgreSQL clock_timestamp() during the evidence claim UPDATE",
      "write": "After claim locks, authority/window checks and attempt-claim CAS; audit and transaction COMMIT still follow. Not claim-function return or commit time.",
      "source": [
        "src/saas/gateway/prepared-request-evidence-service.ts:1999"
      ]
    },
    "response_started_at": {
      "clock": "First response_started=true state transition: GREATEST(previous attempt.updated_at, one PG clock_timestamp() observation); then immutable",
      "write": "Normal dispatch awaits full response delivery before persisting sent state. First client.start only updates delivery memory. Errors/cancellation may persist the marker later through uncertainty handling. This is a state marker, not upstream/client headers, first byte, TTFB or a socket timestamp.",
      "source": [
        "src/saas/metering/service.ts:2326",
        "src/saas/gateway/prepared-evidence-dispatch-service.ts:731",
        "src/saas/gateway/prepared-evidence-dispatch-service.ts:949",
        "src/saas/gateway/prepared-evidence-dispatch-service.ts:1045"
      ]
    },
    "attempt_updated_at": {
      "clock": "Initially application Date; claim and later attempt transitions use PG clock_timestamp() clamped to the previous row value",
      "write": "Overwritten by the latest claim/attempt-state transition; normal success later writes succeeded. Not response completion or COMMIT time.",
      "source": [
        "src/saas/gateway/prepared-request-evidence-service.ts:1980",
        "src/saas/metering/service.ts:2333",
        "src/saas/metering/conditional-settlement-port.ts:1260"
      ]
    },
    "request_updated_at": {
      "clock": "Application wall clock, normalizeNow(this.now), sampled before each request/financial UPDATE",
      "write": "Latest transition overwrites it. Normal platform success performs reconciliation/request-success transitions then a financial transition; later SQL, webhook work and COMMIT are not represented.",
      "source": [
        "src/saas/metering/service.ts:2564",
        "src/saas/metering/service.ts:2611",
        "src/saas/metering/conditional-settlement-port.ts:1274",
        "src/saas/metering/conditional-settlement-port.ts:1295"
      ]
    }
  },
  "attributionLimits": [
    "No mixed application/PG wall-clock differences are calculated in this summary; negative request_created_at to evidence_created_at gaps are not phase durations",
    "evidence_created_at to evidence_claimed_at describes preparation-transaction-start to claim-UPDATE wall-clock marker spacing, not one isolated phase",
    "evidence_claimed_at to response_started_at describes claim-state to response-state persistence spacing, subject to clamping; it spans claim tail/commit, later reads/CAS, credential/transport, full response delivery and state persistence",
    "response_started_at to request_updated_at mixes clocks and a latest-overwritten state marker; it is not complete settlement, COMMIT or client completion duration",
    "No field records durable COMMIT time; application Date has millisecond precision while raw PG text can retain microseconds, which Date.parse discards",
    "Ingress/authentication/authority/scheduler/payload work before request creation is not covered by these marker rows",
    "Client-minus-DB residual cannot be attributed to network, CPU or DB waiting; aggregate event-loop/GC and stage metrics do not correlate individual requests",
    "Selected rows provide correlation only; aggregate stage means are not subtracted from a client p99 and do not explain the selected slow request"
