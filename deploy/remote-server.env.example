# 复制为 remote-server.local.env 后填写；该本地文件已被 Git 忽略。
# 格式是字面量 KEY=VALUE，不加引号，不写 export，不支持行尾注释或变量展开。
# 密码中的空格、$、!、# 都按原样读取；私钥只填写路径，不粘贴私钥内容。

SERVER_IP=
SERVER_PORT=22
SERVER_USERNAME=

# 认证优先级：私钥文件 > 密码 > SSH agent / ~/.ssh/config。
# 私钥推荐保存在仓库外，例如 /Users/your-name/.ssh/id_ed25519。
# 带口令的私钥可先用 ssh-add 加入 agent，或在终端按提示解锁。
SERVER_SSH_KEY=
SERVER_PASSWORD=

# 登录用户必须能写此目录，并有 Docker daemon 使用权限。
SERVER_DEPLOY_DIR=/opt/model-router

# managed-saas：当前 SaaS 多角色服务（需要服务器端 .env、模块和显式迁移）。
# self-hosted：单机 SQLite 模式（首次部署会创建空配置）。
DEPLOYMENT_KIND=managed-saas
