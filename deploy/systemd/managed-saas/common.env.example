# Reviewed, non-secret deployment metadata shared by every managed SaaS
# workload on this node. Install as /etc/model-router-saas/common.env,
# 0440 root:model-router. Secret-bearing values (database URLs, KMS master
# keys) belong in the per-role files, 0400 root:model-router, never committed.

MODEL_ROUTER_SAAS_DEPLOYMENT_ID=
MODEL_ROUTER_SAAS_ENVIRONMENT_ID=

# Redis: control-plane authentication rate limiting / derived cache only,
# never an authoritative ledger or gateway lease store. (The gateway's
# optional sticky-session Redis is a SEPARATE role-scoped setting — see
# gateway.env.example; this control-plane declaration must not reach the
# gateway workload.)
MODEL_ROUTER_SAAS_REDIS_URL=

# Trusted runtime module specifiers (module identity, not key material).
# The software KMS module is pilot-only; see deploy/README.md before any
# non-pilot use. Key material for it goes to the per-role secret files as
# MODEL_ROUTER_SAAS_SOFTWARE_KMS_MASTER_KEY (+ _KEY_ID / _PREVIOUS_MASTER_KEYS).
SAAS_PROVIDER_CREDENTIAL_SEAL_KMS_MODULE=
SAAS_PROVIDER_CREDENTIAL_REWRAP_KMS_MODULE=
SAAS_GATEWAY_PROVIDER_CREDENTIAL_DECRYPT_KMS_MODULE=
MODEL_ROUTER_SAAS_VALIDATION_WORKER_PROVIDER_CREDENTIAL_DECRYPT_KMS_MODULE=
MODEL_ROUTER_SAAS_CREDENTIAL_VALIDATION_TARGETS_MODULE=
MODEL_ROUTER_SAAS_KMS_PROVIDER=
MODEL_ROUTER_SAAS_PROVIDER_CREDENTIAL_KMS_KEY_ID=

# Customer/platform listeners (control-plane workload).
MODEL_ROUTER_SAAS_CUSTOMER_BIND_ADDRESS=127.0.0.1
MODEL_ROUTER_SAAS_CUSTOMER_PORT=
MODEL_ROUTER_SAAS_CUSTOMER_ORIGIN=
MODEL_ROUTER_SAAS_PLATFORM_BIND_ADDRESS=127.0.0.1
MODEL_ROUTER_SAAS_PLATFORM_PORT=
MODEL_ROUTER_SAAS_PLATFORM_ORIGIN=

# Gateway listener (gateway workload).
MODEL_ROUTER_SAAS_GATEWAY_BIND_ADDRESS=127.0.0.1
MODEL_ROUTER_SAAS_GATEWAY_PORT=
MODEL_ROUTER_SAAS_GATEWAY_ORIGIN=
