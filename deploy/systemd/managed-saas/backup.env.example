# Install this secret file outside the package, root:model-router-backup 0400.
MODEL_ROUTER_SAAS_BACKUP_POLICY_FILE=/etc/model-router-saas/backup-policy.json
MODEL_ROUTER_SAAS_BACKUP_STATUS_FILE=/var/lib/model-router-saas-backup-status/status.json
# Separate backup operator login; do not use gateway/control-plane credentials.
# Put the actual PostgreSQL URL only in the local installed file.
MODEL_ROUTER_SAAS_DEPLOY_ADMIN_URL=
# Prefer workload IAM identities. Explicit static credential environment names
# must also be listed in the relevant policy adapter's envNames list.
MODEL_ROUTER_SAAS_BACKUP_KMS_CANARIES_FILE=/etc/model-router-saas/kms-recovery-canaries.json
MODEL_ROUTER_SAAS_BACKUP_AWS_EXECUTABLE=/usr/local/bin/aws
# AWS_CONFIG_FILE can select a separate recovery profile assuming the recovery
# role. Never grant the production application write access to recovery keys.
AWS_CONFIG_FILE=/etc/model-router-saas/backup-aws-config
AWS_PROFILE=model-router-backup
MODEL_ROUTER_SAAS_BACKUP_RECOVERY_AWS_PROFILE=model-router-recovery
