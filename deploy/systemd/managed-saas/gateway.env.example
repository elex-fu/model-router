# Gateway role secrets. Install as /etc/model-router-saas/gateway.env,
# 0400 root:model-router. Decrypt-only KMS posture: this role must not hold
# the seal/rewrap capability beyond what its module exposes.
MODEL_ROUTER_SAAS_GATEWAY_DATABASE_URL=

# Optional gateway-scoped Redis (redis:// or rediss://) for the sticky-session
# fast path ONLY — PostgreSQL stays the authoritative affinity source and every
# Redis error fails open. Keep this line COMMENTED for a pure-PG gateway: an
# uncommented empty value is a present-but-empty declaration and the
# deployment parser fails startup closed (INVALID_REDIS_URL). Never set the
# control-plane MODEL_ROUTER_SAAS_REDIS_URL/REDIS_PROVIDER pair here: the
# parser rejects those cross-role declarations for this workload.
# MODEL_ROUTER_SAAS_GATEWAY_REDIS_URL=redis://127.0.0.1:6379

MODEL_ROUTER_SAAS_SOFTWARE_KMS_MASTER_KEY=
MODEL_ROUTER_SAAS_SOFTWARE_KMS_KEY_ID=
MODEL_ROUTER_SAAS_SOFTWARE_KMS_PREVIOUS_MASTER_KEYS=
