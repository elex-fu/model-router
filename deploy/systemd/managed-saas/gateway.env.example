# Gateway role secrets. Install as /etc/model-router-saas/gateway.env,
# 0400 root:model-router. Decrypt-only KMS posture: this role must not hold
# the seal/rewrap capability beyond what its module exposes.
MODEL_ROUTER_SAAS_GATEWAY_DATABASE_URL=

# PostgreSQL pool for this gateway process only; each CLI process/replica has
# its own pool. Defaults are 16 connections and a 5000 ms acquisition timeout.
# Set acquisition timeout to 0 to disable it.
# MODEL_ROUTER_SAAS_DB_POOL_MAX=16
# MODEL_ROUTER_SAAS_DB_POOL_ACQUISITION_TIMEOUT_MILLIS=5000

# Optional HTTP handler cap for this gateway process; unset or empty disables
# it. This explicit candidate value is pending benchmark validation.
# MODEL_ROUTER_SAAS_GATEWAY_MAX_HTTP_IN_FLIGHT=8

# Three fixed gateway SELECTs may reuse native wire prepared plans. Keep off
# for an unknown pooler. Native requires a direct/session-compatible server or
# a verified transaction pooler with wire prepared-statement tracking enabled.
MODEL_ROUTER_SAAS_DB_PREPARED_STATEMENTS=off

# Gateway-scoped Redis (redis:// or rediss://) for shared non-financial quota
# admission/journal and affinity. Quota Redis errors reject admissions; affinity
# keeps PostgreSQL fallback. Use AOF everysec + noeviction + durable volume.
# All gateway replicas must use one consistent capacity mode. An
# uncommented empty value is a present-but-empty declaration and the
# deployment parser fails startup closed (INVALID_REDIS_URL). Never set the
# control-plane MODEL_ROUTER_SAAS_REDIS_URL/REDIS_PROVIDER pair here: the
# parser rejects those cross-role declarations for this workload.
# MODEL_ROUTER_SAAS_GATEWAY_REDIS_URL=redis://127.0.0.1:6379

MODEL_ROUTER_SAAS_SOFTWARE_KMS_MASTER_KEY=
MODEL_ROUTER_SAAS_SOFTWARE_KMS_KEY_ID=
MODEL_ROUTER_SAAS_SOFTWARE_KMS_PREVIOUS_MASTER_KEYS=
