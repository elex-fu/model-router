# Gateway role secrets. Install as /etc/model-router-saas/gateway.env,
# 0400 root:model-router. Decrypt-only KMS posture: this role must not hold
# the seal/rewrap capability beyond what its module exposes.
MODEL_ROUTER_SAAS_GATEWAY_DATABASE_URL=

MODEL_ROUTER_SAAS_SOFTWARE_KMS_MASTER_KEY=
MODEL_ROUTER_SAAS_SOFTWARE_KMS_KEY_ID=
MODEL_ROUTER_SAAS_SOFTWARE_KMS_PREVIOUS_MASTER_KEYS=
