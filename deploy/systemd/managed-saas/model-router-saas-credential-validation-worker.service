[Unit]
# Managed SaaS credential-validation worker: no listeners. Claims validation
# jobs from both owner queues, decrypts credentials with its own KMS module
# and probes providers. Fail-closed contract: schema readiness (15 relations,
# both owner scopes), least-privilege ACL verification and KMS self-probe all
# run before the first claim; any failure is a non-zero exit.
Description=model-router managed SaaS credential-validation worker (no listeners)
After=network-online.target
Wants=network-online.target
After=postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=model-router
Group=model-router
WorkingDirectory=/opt/model-router
# Secrets live only in these files (install 0400 root:model-router):
#   common.env                       — deployment/environment IDs, KMS module
#                                      specifiers, Redis URL
#   credential-validation-worker.env — MODEL_ROUTER_SAAS_VALIDATION_WORKER_DATABASE_URL,
#                                      worker KMS module specifier, validation
#                                      targets module
EnvironmentFile=/etc/model-router-saas/common.env
EnvironmentFile=/etc/model-router-saas/credential-validation-worker.env
Environment=NODE_ENV=production
Environment=MODEL_ROUTER_DEPLOYMENT_MODE=managed-saas
ExecStart=/usr/bin/node /opt/model-router/dist/cli/index.js start --role credential-validation-worker
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
