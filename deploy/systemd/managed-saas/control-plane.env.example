# Control-plane role secrets. Install as
# /etc/model-router-saas/control-plane.env, 0400 root:model-router.
# Least-privilege role DSN; never the migration-capable URL.
MODEL_ROUTER_SAAS_CONTROL_PLANE_DATABASE_URL=

# Software KMS pilot only: 64-hex current master key; key id must match the
# deployment key id; up to 16 previous keys as comma-separated keyId=hex.
MODEL_ROUTER_SAAS_SOFTWARE_KMS_MASTER_KEY=
MODEL_ROUTER_SAAS_SOFTWARE_KMS_KEY_ID=
MODEL_ROUTER_SAAS_SOFTWARE_KMS_PREVIOUS_MASTER_KEYS=
