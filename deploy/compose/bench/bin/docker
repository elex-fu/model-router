#!/bin/sh
# docker shim for the R9 chaos driver (gitignored): the chaos script shells
# out to `docker compose ...` (plugin syntax), but this environment only has
# the standalone `docker-compose` binary. Translate the subcommand and
# delegate everything else to the real CLI.
if [ "$1" = "compose" ]; then
  shift
  exec /opt/homebrew/bin/docker-compose "$@"
fi
exec /opt/homebrew/bin/docker "$@"
