# deploy/compose/.env.example — full variable set for the managed SaaS
# Docker Compose stack (Phase 4). Copy to .env (never commit it) and replace
# every <set-me> placeholder.
#
# Variable names follow src/saas/deployment.ts (the authoritative env
# contract) and the per-role env examples in deploy/systemd/managed-saas/.
# Per-role isolation is enforced in docker-compose.yml: each workload service
# only receives the variables its role permits (the deployment parser
# fail-closes on cross-role settings).

## ── Deployment identity (non-secret AAD; required in production) ─────────
## Stable identities bound into sealed credential envelopes. Changing them
## after sealing makes existing envelopes undecryptable (fail-closed).
MODEL_ROUTER_SAAS_DEPLOYMENT_ID=<set-me>
MODEL_ROUTER_SAAS_ENVIRONMENT_ID=<set-me>

## ── PostgreSQL (single dedicated database, per-role login isolation) ─────
## The superuser password protects the data volume; the four role passwords
## back the per-role database URLs composed in docker-compose.yml. Use long
## random values; avoid characters that need URL-encoding (: / @ % ? #).
POSTGRES_DB=model_router_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<set-me>
POSTGRES_MIGRATOR_PASSWORD=<set-me>
POSTGRES_CONTROL_PLANE_PASSWORD=<set-me>
POSTGRES_GATEWAY_PASSWORD=<set-me>
POSTGRES_VALIDATION_WORKER_PASSWORD=<set-me>

## ── Redis (control-plane cache/coordination only; not authoritative) ─────
## Defaults to the compose redis service; no AUTH because it is only
## reachable on the compose network. Override only for an external Redis.
#MODEL_ROUTER_SAAS_REDIS_URL=redis://redis:6379
## Trusted Redis-provider module (createRedisProvider) for auth rate limiting;
## the in-image default is shown.
#MODEL_ROUTER_SAAS_REDIS_PROVIDER=./dist/saas/runtime/redis-rate-limit-provider.js

## ── Trusted module specs (module identity, never key material) ───────────
## In-image modules (pilot-only software KMS + Redis provider):
##   ./dist/saas/runtime/software-provider-credential-kms.js  — seal/gateway
##     decrypt/validation-worker decrypt factories
##   ./dist/saas/runtime/software-provider-credential-rewrapping-kms.mjs —
##     dedicated ReEncrypt-only entry (must stay distinct from the above)
##   ./dist/saas/runtime/redis-rate-limit-provider.js — createRedisProvider
## Operator-supplied modules must be mounted under ./modules/ and referenced
## by absolute path (see deploy/README.md for the factory contracts):
MODEL_ROUTER_SAAS_KMS_PROVIDER=/opt/model-router-modules/platform-totp-provider.mjs
MODEL_ROUTER_SAAS_GATEWAY_RUNTIME_MODULE=/opt/model-router-modules/gateway-runtime.mjs
SAAS_PROVIDER_CREDENTIAL_SEAL_KMS_MODULE=./dist/saas/runtime/software-provider-credential-kms.js
SAAS_PROVIDER_CREDENTIAL_REWRAP_KMS_MODULE=./dist/saas/runtime/software-provider-credential-rewrapping-kms.mjs
SAAS_GATEWAY_PROVIDER_CREDENTIAL_DECRYPT_KMS_MODULE=./dist/saas/runtime/software-provider-credential-kms.js
SAAS_VALIDATION_WORKER_PROVIDER_CREDENTIAL_DECRYPT_KMS_MODULE=./dist/saas/runtime/software-provider-credential-kms.js

## ── Provider credential KMS key id (sealing context; required for prod) ──
## Must equal MODEL_ROUTER_SAAS_SOFTWARE_KMS_KEY_ID below while the pilot
## software KMS module is in use.
MODEL_ROUTER_SAAS_PROVIDER_CREDENTIAL_KMS_KEY_ID=<set-me>

## ── Pilot software KMS master keys (per-role; PILOT-ONLY) ────────────────
## 64 hex chars (32 bytes) for the current AES-256-GCM master key. WARNING:
## the software KMS is strictly weaker than a cloud KMS and must not serve a
## charging production environment (deploy/README.md, section B1a). Setting
## ALLOW_PILOT=true is the explicit operator acceptance of that downgrade.
MODEL_ROUTER_SAAS_SOFTWARE_KMS_MASTER_KEY=<set-me-64-hex>
MODEL_ROUTER_SAAS_SOFTWARE_KMS_KEY_ID=<set-me-must-match-KMS_KEY_ID-above>
## Optional comma-separated keyId=hexKey entries (<=16) for pre-rotation
## envelopes; required during KMS rotation until the rewrap completes.
#MODEL_ROUTER_SAAS_SOFTWARE_KMS_PREVIOUS_MASTER_KEYS=
MODEL_ROUTER_SAAS_SOFTWARE_KMS_ALLOW_PILOT=true

## ── Listeners (per-role; non-loopback Origins must be https) ─────────────
## In-container bind addresses/ports; compose publishes the host ports
## listed after them. Origins are the exact public canonical Origins fronted
## by your TLS reverse proxy.
MODEL_ROUTER_SAAS_CUSTOMER_BIND_ADDRESS=0.0.0.0
MODEL_ROUTER_SAAS_CUSTOMER_PORT=15005
MODEL_ROUTER_SAAS_CUSTOMER_ORIGIN=https://console.example.com
CUSTOMER_HOST_PORT=15005
MODEL_ROUTER_SAAS_PLATFORM_BIND_ADDRESS=0.0.0.0
MODEL_ROUTER_SAAS_PLATFORM_PORT=15006
MODEL_ROUTER_SAAS_PLATFORM_ORIGIN=https://admin.example.com
PLATFORM_HOST_PORT=15006
MODEL_ROUTER_SAAS_GATEWAY_BIND_ADDRESS=0.0.0.0
MODEL_ROUTER_SAAS_GATEWAY_PORT=15007
MODEL_ROUTER_SAAS_GATEWAY_ORIGIN=https://api.example.com

## ── Gateway scaling ───────────────────────────────────────────────────────
## replicas must fit the inclusive host-port range below (one port each).
GATEWAY_REPLICAS=1
GATEWAY_HOST_PORT_START=15007
GATEWAY_HOST_PORT_END=15009

## ── Optional trusted capability modules (not wired by default) ───────────
## Uncommenting these requires also adding the matching environment entries
## in docker-compose.yml; an EMPTY value is invalid and fail-closes startup.
## Customer TOTP capability module (control-plane only):
#MODEL_ROUTER_SAAS_CUSTOMER_MFA_CAPABILITY_MODULE=/opt/model-router-modules/customer-mfa-capability.mjs
## Customer passkey capability module (control-plane only):
#MODEL_ROUTER_SAAS_CUSTOMER_PASSKEY_CAPABILITY_MODULE=/opt/model-router-modules/customer-passkey-capability.mjs
## Trusted static credential-validation target metadata (validation worker only):
#MODEL_ROUTER_SAAS_CREDENTIAL_VALIDATION_TARGETS_MODULE=/opt/model-router-modules/credential-validation-targets.mjs

## ── Fixed deployment mode (never change these) ────────────────────────────
## NODE_ENV=production enables the runtime privilege ACL probes; the
## deployment mode and per-role workload role are pinned per service in
## docker-compose.yml.
